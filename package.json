{
  "name": "macro-economy-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev-all.ts",
    "build": "next build",
    "start": "next start",
    "start:all": "tsx scripts/start-production.ts",
    "lint": "eslint",
    "ingest": "tsx scripts/ingest.ts",
    "backfill": "tsx scripts/ingest.ts backfill",
    "refresh": "tsx scripts/ingest.ts refresh",
    "simulate:releases": "tsx scripts/simulate-release-updates.ts",
    "capture:investing": "tsx scripts/capture-investing-month.ts",
    "simulate:investing": "tsx scripts/simulate-investing-import.ts",
    "audit:surprise": "tsx scripts/audit-investing-surprise.ts",
    "remap:investing": "tsx scripts/remap-investing.ts",
    "db:push": "tsx -e \"import { ensureSchema, seedCatalog } from './src/ingest/pipeline'; ensureSchema().then(seedCatalog).then(() => console.log('ok'))\"",
    "release:worker": "tsx scripts/release-worker.ts",
    "dev:next": "next dev --turbopack",
    "dev:all": "tsx scripts/dev-all.ts",
    "release:once": "tsx scripts/release-worker.ts",
    "validate:release-pipeline": "tsx scripts/validate-release-pipeline.ts",
    "release:lseg": "python Economic_calendar/lseg_worker.py",
    "repair:bea-derived": "tsx scripts/repair-bea-derived.ts",
    "calendar:refresh": "node scripts/refresh-calendar.mjs",
    "calendar:worker": "node scripts/calendar-worker.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@libsql/isomorphic-ws": "^0.1.5",
    "@next/env": "^16.3.6",
    "@opennextjs/cloudflare": "^1.20.8",
    "adm-zip": "^0.6.1",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "next": "^15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^15.5.27",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
