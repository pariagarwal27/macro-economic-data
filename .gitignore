# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database
/data
*.db
*.db-*
# The release calendar DB is the deployed schedule source and is intentionally tracked.
!Economic_calendar/economic_calendar.db
!Economic_calendar/master_calendar.json
!Economic_calendar/all_calendar_results.json
!Economic_calendar/*_fetch_results.json
!Economic_calendar/fred_bls_release_dates.json

# investing.com browser profile (Cloudflare cookies)
.playwright-investing-profile/
