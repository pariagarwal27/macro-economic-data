{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/countries/[region]",
      "regex": "^/api/countries/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPregion": "nxtPregion"
      },
      "namedRegex": "^/api/countries/(?<nxtPregion>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/dashboard/[region]",
      "regex": "^/api/dashboard/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPregion": "nxtPregion"
      },
      "namedRegex": "^/api/dashboard/(?<nxtPregion>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/inflation/[region]",
      "regex": "^/api/inflation/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPregion": "nxtPregion"
      },
      "namedRegex": "^/api/inflation/(?<nxtPregion>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/metrics/[id]",
      "regex": "^/api/metrics/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/metrics/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/country/[region]",
      "regex": "^/country/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPregion": "nxtPregion"
      },
      "namedRegex": "^/country/(?<nxtPregion>[^/]+?)(?:/)?$"
    },
    {
      "page": "/country/[region]/inflation/[kind]",
      "regex": "^/country/([^/]+?)/inflation/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPregion": "nxtPregion",
        "nxtPkind": "nxtPkind"
      },
      "namedRegex": "^/country/(?<nxtPregion>[^/]+?)/inflation/(?<nxtPkind>[^/]+?)(?:/)?$"
    },
    {
      "page": "/metrics/[id]",
      "regex": "^/metrics/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/metrics/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/calendar",
      "regex": "^/calendar(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/calendar(?:/)?$"
    },
    {
      "page": "/desk",
      "regex": "^/desk(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/desk(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/us-inflation",
      "regex": "^/us\\-inflation(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/us\\-inflation(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}